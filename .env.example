# ============================================================================
# ChroniQ MCP Server — Production / Deployment Environment Configuration
# ============================================================================

# 1. ChroniQ Backend Connection
# Replace with your deployed ChroniQ backend URL (e.g. https://chroniq-backend.onrender.com)
CHRONIQ_API_BASE_URL=http://127.0.0.1:8000
CHRONIQ_REQUEST_TIMEOUT=15.0
CHRONIQ_CONNECT_TIMEOUT=5.0

# 2. MCP Server Transport (Streamable HTTP for Render & Healix)
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_TRANSPORT=streamable-http
MCP_PATH=/mcp

# 3. Patient Mutation Controls
# Set to 'true' to allow booking, cancelling, slot-holding, and profile updates.
# Set to 'false' if you want a read-only preview deployment.
CHRONIQ_ENABLE_MUTATIONS=true

# 4. Multi-Patient Authentication
# Leave CHRONIQ_AUTH_TOKEN empty in production/deployment!
# Healix / clients pass "Authorization: Bearer <patient-jwt>" in the HTTP request headers.
# The server's BearerAuthMiddleware automatically extracts and isolates each patient's token per request.
CHRONIQ_AUTH_TOKEN=
