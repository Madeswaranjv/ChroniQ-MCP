# ChroniQ backend connection
CHRONIQ_API_BASE_URL=http://127.0.0.1:8000
CHRONIQ_REQUEST_TIMEOUT=15.0
CHRONIQ_CONNECT_TIMEOUT=5.0

# MCP server transport configuration
MCP_HOST=0.0.0.0
MCP_PORT=8001
# PORT=8001  # Hosting platforms (e.g. Render) supply PORT automatically
MCP_TRANSPORT=streamable-http  # Supported: streamable-http, sse, stdio
MCP_PATH=/mcp

# Safety: mutations disabled by default
CHRONIQ_ENABLE_MUTATIONS=false

# Dev-only: single-patient bearer token for local fallback testing.
# NEVER use a shared admin/super-admin token.
# NEVER set this in production. Multi-patient production uses HTTP Authorization Bearer headers per request.
# CHRONIQ_AUTH_TOKEN=
