# ChroniQ backend connection
CHRONIQ_API_BASE_URL=http://127.0.0.1:8000
CHRONIQ_REQUEST_TIMEOUT=15.0
CHRONIQ_CONNECT_TIMEOUT=5.0

# MCP server transport
MCP_HOST=127.0.0.1
MCP_PORT=8001

# Safety: mutations disabled by default
CHRONIQ_ENABLE_MUTATIONS=false

# Dev-only: single-patient bearer token for local testing.
# NEVER use a shared admin/super-admin token.
# NEVER set this in production. Use MCP session-scoped token forwarding instead.
# CHRONIQ_AUTH_TOKEN=
